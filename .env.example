# Copy this file to .env and fill in your email settings.

PORT=3000

# The email address visitors' messages will be sent to.
CONTACT_RECEIVER=chidubemezeamii@gmail.com

# SMTP account used by Nodemailer.
# Gmail example:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# Optional: name shown as the sender
CONTACT_FROM_NAME=Chidubem Ezeamii Portfolio
